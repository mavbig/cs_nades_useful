generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lineup {
  id             String    @id @default(uuid())
  map            String
  side           String    // "T", "CT", "ANY"
  utility        String    // "SMOKE", "FLASH", "MOLLY", "HE", "DECOY"
  title          String
  description    String?
  tags           String    // Comma-separated
  startSpot      String
  throwType      String    // see lib/throw-types.ts
  tickrate       String    // "TR64", "TR128", "ANY"
  screenshotPath String
  clipPath       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([map])
}

model SpawnSmokeSet {
  id                String               @id @default(uuid())
  map               String
  side              String               // "T" or "CT"
  title             String
  description       String?
  overviewImagePath String?
  thumbnailPath     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  positions         SpawnSmokePosition[]

  @@index([map])
}

model SpawnSmokePosition {
  id             String        @id @default(uuid())
  setId          String
  set            SpawnSmokeSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  label          String
  sortOrder      Int
  throwType      String        @default("STAND")
  screenshotPath String
  description    String?

  @@index([setId])
}
